{
  // Server side: Vercel Functions, shared lib, scripts, and tests. Type-check only;
  // Vercel compiles api/ on deploy and Node 24 runs .ts scripts directly.
  // Imports use explicit .ts extensions everywhere so Node's type stripping can
  // resolve them; the client build rewrites them to .js.
  // typeRoots is explicit because Vercel compiles each function through a temporary
  // tsconfig that extends this one from the system temp folder; the default lookup would
  // start there and miss node_modules/@types (TS2688). scripts/check-vercel-ts.ts checks it.
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["api", "lib", "scripts", "tests", "playwright.config.ts"]
}
