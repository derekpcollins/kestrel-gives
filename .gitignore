# Secrets: never committed (SPEC §4)
.env
.env.*

# Local upload storage for dev and tests (SPEC §4)
.local-uploads/

# Dependencies and build output
node_modules/
public/js/
public/styles/components.css
*.tsbuildinfo

# Vercel
.vercel/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# OS / editor
.DS_Store

# Visual-review screenshots (regenerated by npm run check:visual)
visual-review/

.env.pixabay

# Seed photos never go in git (DECISIONS #77): Pixabay originals, and the processed
# copies that local dev serves from public/seed/ (the deployed site reads them from Blob)
.seed-photos/
public/seed/*.jpg

# Checkpoint screenshots for the owner to open directly (Milestone 4 on)
.review/

# Handoff notes between the owner's reviewer chat and the agent; never committed
.handoff/
