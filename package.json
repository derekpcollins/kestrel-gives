{
  "name": "kestrel-gives",
  "version": "0.1.0",
  "private": true,
  "description": "Kestrel Gives: a charity auction web app, recreated from memory as a case study in designing and building with AI.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.client.json && node scripts/build-css.ts",
    "check:types": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local scripts/seed.ts",
    "test:rules": "NODE_ENV=test node --env-file-if-exists=.env.local --test 'tests/unit/**/*.test.ts'",
    "db:check": "node --env-file=.env.local scripts/db-check.ts",
    "start": "node scripts/dev.ts",
    "check:deps": "node scripts/check-deps.ts",
    "check:tokens": "node scripts/check-tokens.ts",
    "check:a11y": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/e2e/a11y.spec.ts",
    "check:visual": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/e2e/visual.spec.ts",
    "check:reflow": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/e2e/reflow.spec.ts --project=reflow-320",
    "check": "npm run check:deps && npm run check:tokens && npm run check:types && npm run test:rules && npm run check:a11y && npm run check:reflow && npm run check:visual"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  }
}
