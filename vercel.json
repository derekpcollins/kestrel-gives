{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron-restore",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin/people",
      "destination": "/admin"
    },
    {
      "source": "/admin/proofs",
      "destination": "/admin"
    },
    {
      "source": "/your-items/proof",
      "destination": "/proof"
    },
    {
      "source": "/items/:id/edit",
      "destination": "/submit"
    },
    {
      "source": "/items/:id",
      "destination": "/item"
    }
  ]
}
