{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron-restore",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/items/:id",
      "destination": "/item"
    }
  ]
}
